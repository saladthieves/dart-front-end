{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "config-ninja-debug",
            "detail": "Runs cmake with the config-ninja-debug preset.",
            "group": "build",
            "hide": true,
            "command": "cmake",
            "args": [
                "--preset",
                "config-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "build-ninja-debug",
            "detail": "Builds the dart_front_end target with Ninja in Debug mode.",
            "group": "build",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--preset",
                "build-ninja-debug"
            ]
        },
        {
            "type": "shell",
            "label": "build-ninja-debug-clean",
            "detail": "Cleans and rebuilds the dart_front_end target with Ninja in Debug mode.",
            "group": "build",
            "dependsOn": [
                "clean",
                "config-ninja-debug",
                "build-ninja-debug"
            ],
            "dependsOrder": "sequence"
        },
        {
            "type": "shell",
            "label": "config-ninja-test",
            "detail": "Runs cmake with the config-ninja-test preset.",
            "group": "build",
            "hide": true,
            "command": "cmake",
            "args": [
                "--preset",
                "config-ninja-test"
            ]
        },
        {
            "type": "shell",
            "label": "build-ninja-test",
            "detail": "Builds the dart_front_end_test target with Ninja in Debug mode.",
            "group": "build",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--preset",
                "build-ninja-test"
            ]
        },
                {
            "type": "shell",
            "label": "build-ninja-test-clean",
            "detail": "Cleans and rebuilds the dart_front_end_test target with Ninja in Debug mode.",
            "group": "build",
            "dependsOn": [
                "clean",
                "config-ninja-test",
                "build-ninja-test"
            ],
            "dependsOrder": "sequence"
        },

        {
            "type": "shell",
            "label": "clean",
            "detail": "Removes all build binaries and cache files.",
            "group": "build",
            "hide": true,
            "command": "rm",
            "args": [
                "-rf",
                "build/CMakeCache.txt",
                "build/CMakeFiles",
                "build/dart_front_end",
                "build/dart_front_end_test"
            ]
        }
    ]
}